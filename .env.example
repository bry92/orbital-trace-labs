# Copy to .env.local (git-ignored) and fill in a real key. The application itself reads no
# environment variables; these are used only by the optional verification archive tooling
# in scripts/archil-evidence.mjs.

# Account-level Archil control-plane API key. Required by every archil-evidence command.
ARCHIL_API_KEY=

# Archil region identifier: aws-us-east-1, aws-us-west-2, aws-eu-west-1 or gcp-us-central1.
ARCHIL_REGION=aws-us-east-1

# Disk that holds the archived verification evidence across runs.
ARCHIL_DISK_NAME=orbital-trace-labs-evidence

# Optional: address an existing disk by id instead of looking it up by name.
# ARCHIL_DISK_ID=
